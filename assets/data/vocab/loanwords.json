 "rules_table": [
  [
   "Consonant clusters (st, sk, pr)",
   "Add 으 between",
   "stress → 스트레스 · cream → 크림"
  ],
  [
   "Final s · k · t (in long words)",
   "스 · 크 · 트",
   "bus → 버스 · cake → 케이크 · test → 테스트"
  ],
  [
   "Final p · t · k (short vowel)",
   "ㅂ · ㅅ · ㄱ",
   "cup → 컵 · robot → 로봇 · black → 블랙"
  ],
  [
   "F · PH",
   "ㅍ",
   "coffee → 커피 · phone → 폰"
  ],
  [
   "V",
   "ㅂ",
   "video → 비디오"
  ],
  [
   "B · P",
   "ㅂ · ㅍ",
   "banana → 바나나 · piano → 피아노"
  ],
  [
   "R · L (start of syllable)",
   "ㄹ",
   "radio → 라디오 · lemon → 레몬"
  ],
  [
   "L in the middle",
   "ㄹㄹ",
   "cola → 콜라 · salad → 샐러드"
  ],
  [
   "Final L",
   "ㄹ",
   "hotel → 호텔"
  ],
  [
   "Z · J",
   "ㅈ",
   "size → 사이즈 · juice → 주스"
  ],
  [
   "CH · final -ch",
   "ㅊ · 치",
   "cheese → 치즈 · bench → 벤치"
  ],
  [
   "SH",
   "시 · 샤 · 쇼 · 슈",
   "shower → 샤워 · fashion → 패션"
  ],
  [
   "TH",
   "ㅅ or ㄷ",
   "thriller → 스릴러 · rhythm → 리듬"
  ],
  [
   "a (cat) · a (father)",
   "애 · 아",
   "camp → 캠프 · banana → 바나나"
  ],
  [
   "-er · -or · -ar",
   "어 (no r)",
   "computer → 컴퓨터 · monitor → 모니터"
  ],
  [
   "ee · ea · oo",
   "이 · 우",
   "team → 팀 · cookie → 쿠키"
  ],
  [
   "Long o (boat)",
   "오 (not 오우)",
   "boat → 보트 · window → 윈도"
  ]
